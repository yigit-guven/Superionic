{
	"schemaVersion": 1,
	"id": "superionic",
	"version": "${version}",
	"name": "Superionic",
	"description": "An all-in-one optimization suite that boosts FPS and eliminates stutters by revamping Minecraft's rendering and logic.",
	"authors": [
		"Yigit Guven"
	],
	"contact": {
		"homepage": "https://github.com/yigit-guven/Superionic",
		"sources": "https://github.com/yigit-guven/Superionic",
		"issues": "https://github.com/yigit-guven/Superionic/issues",
		"discord": "https://discord.gg/gNajXYku5z",
		"wiki": "https://github.com/yigit-guven/Superionic/wiki"
	},
	"license": "GPL-3.0",
	"icon": "assets/superionic/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.yigitguven.superionic.SuperionicClient"
		],
		"modmenu": [
			"com.yigitguven.superionic.SuperionicMenu"
		]
	},
	"custom": {
		"modmenu": {
			"badges": [
				"client"
			],
			"links": {
				"modmenu.discord": "https://discord.gg/gNajXYku5z"
			}
		}
	},
	"mixins": [
		{
			"config": "superionic.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"cloth-config": "*",
		"modmenu": "*"
	}
}